# ════════════════════════════════════════════════════════════════════════════
#  Connexion d'un client (multi-tenant).
#  Copier ce fichier en  <client-id>.env  (ex. pmu-mali.env, pmu-niger.env).
#  ⚠ NE JAMAIS committer les .env réels : ils contiennent le mot de passe DB.
#     (Le .gitignore exclut déjà clients/*.env)
#
#  La chaîne DATABASE_URL se récupère dans Supabase :
#    Project Settings → Database → Connection string → URI
#  Utiliser de préférence la connexion DIRECTE (port 5432) pour pg_dump/psql.
#  Remplacer [PASSWORD] par le mot de passe de la base.
# ════════════════════════════════════════════════════════════════════════════

# Identifiant logique du client (doit correspondre à VITE_CLIENT_ID du déploiement).
CLIENT_ID=pmu-exemple

# Connexion Postgres de la base de ce client.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# (Optionnel) Tables de données de référence à copier INTÉGRALEMENT lors d'un
# provisioning --seed. Liste séparée par des espaces. Défaut : referentiel_parametres.
# SEED_TABLES="referentiel_parametres"

# (Optionnel) Clés app_settings à copier depuis la référence lors d'un --seed.
# Ne JAMAIS y mettre les clés propres à un client : client_branding,
# functionalites_espaces, feature_flags, powerbi_ccope_url.
# Bons candidats (gabarits réutilisables) : paramètres de pointage et formules.
# SEED_APP_SETTINGS_KEYS="general salaire_guichetiere_config prelevements_config"

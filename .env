# ── Connexion Supabase ───────────────────────────────────────────────────────
# Self-hosted : URL de la gateway (Kong), typiquement le port 8000.
#   - Accès local sur la machine serveur : http://localhost:8000
#   - Accès depuis un autre poste du réseau : http://<IP-du-serveur>:8000
#   - Via un nom de domaine / reverse-proxy : https://supabase.mondomaine.fr
VITE_SUPABASE_URL=/supabase
# Clé "anon" publique de votre instance self-hosted.
# Self-hosted : valeur ANON_KEY de votre fichier docker .env (générée avec votre JWT_SECRET).
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzc5Nzg4MTk1LCJleHAiOjIwOTUxNDgxOTV9.8WZv6srn7Y-S14z3-0uj8rq69yt5zy_Qg5dB__MJ8uo

# ── Azure AD / Power BI Embedded ─────────────────────────────────────────────
# Tenant ID Azure AD (identique à POWERBI_TENANT_ID dans Supabase)
VITE_AZURE_TENANT_ID=6f578173-2e4e-4d86-ae55-d62afa70c920

# Client ID de l'application Azure AD enregistrée comme SPA
# (pas le même que le service principal — voir README)
VITE_AZURE_CLIENT_ID=

# Variables d'environnement de l'application (préfixe VITE_ = exposées au client).
# Copier ce fichier en `.env` et renseigner les valeurs. Ne JAMAIS committer `.env`.
# En production (Vercel), définir ces variables dans les Project Settings → Environment Variables.

# Supabase (la clé anon est publique par design — la sécurité repose sur les RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Azure AD (identifiants publics pour l'intégration Power BI ; le CLIENT_SECRET reste côté serveur)
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=

# Monitoring d'erreurs Sentry (optionnel). Si vide, le monitoring est désactivé
# et Sentry n'est même pas chargé. Renseigner le DSN du projet Sentry pour l'activer.
VITE_SENTRY_DSN=
